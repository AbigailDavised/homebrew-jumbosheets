const args = process.argv.slice(2);

if (args.includes('--version') || args.includes('-v')) {
  console.log('jumbosheets-cli v1.0.0 (https://jumbosheets.com)');
  process.exit(0);
}

if (args.includes('--routes')) {
  console.log(JSON.stringify({ domain: 'jumbosheets.com', endpoints: ROUTES }, null, 2));
  process.exit(0);
}

if (args.includes('--specs') || args.includes('--json')) {
  console.log(JSON.stringify({ domain: 'jumbosheets.com', benchmark: "Low-Vision Print Accessibility & Multi-Sheet Tiling Specifications", rows: SPECS }, null, 2));
  process.exit(0);
}

console.log([
  'JumboSheets CLI (jumbosheets-cli v1.0.0)',
  'Low-Vision 28pt Senior Large-Print Puzzle & Multi-Sheet Poster Geometry CLI',
  'Homepage: https://jumbosheets.com',
  '',
  'Usage:',
  '  jumbosheets-cli --help       Show command overview and verified endpoints',
  '  jumbosheets-cli --version    Print CLI version',
  '  jumbosheets-cli --specs      Output domain technical specification matrix as JSON',
  '  jumbosheets-cli --routes     Output verified production URLs as JSON',
  '',
  'Verified Production Endpoints:',
  ...ROUTES.map((r) => '  - ' + r.name + ': ' + r.url),
].join('\n'));
